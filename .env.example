# Copy to .env and run with: uv run --env-file .env python -m agent "your question"
# Sign in first with: aws login --profile phishguard --region us-east-1
AWS_PROFILE=phishguard
AWS_REGION=us-east-1
# Haiku 5.5 is the cheap model for day-to-day development; the code default is
# us.anthropic.claude-opus-5-5.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-5-5
