# Copy to .env and run with: uv run --env-file .env python -m agent "your question"
# Sign in first with: aws login --profile phishguard --region us-east-1
# Also save the region in the profile once, or refreshing the sign-in fails with NoRegionError:
#   aws configure set region us-east-1 --profile phishguard
AWS_PROFILE=phishguard
AWS_REGION=us-east-1
# Haiku 4.5 is the cheap model for day-to-day development; the code default is
# us.anthropic.claude-opus-4-6-v1. Claude 4.8 and 5.x models are not enabled on our account.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Local Strands Decider server (strands-decider serve ... --port 8099)
DECIDER_URL=http://127.0.0.1:8099
